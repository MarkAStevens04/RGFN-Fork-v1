@article{guo2026tango,
  title   = {{TANGO}: direct optimization of constrained synthesizability for generative molecular design},
  author  = {Guo, Jeff and Schwaller, Philippe},
  journal = {Nature Computational Science},
  year    = {2026},
  eprint  = {2410.11527},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2410.11527},
  note    = {"It Takes Two to Tango". TANGO (TANimoto Group Overlap) is a REWARD FUNCTION layered on
             a general-purpose generator ([guo2026saturn]), not a separate model: it turns the sparse
             binary signal "is this molecule retrosynthesizable from a SPECIFIED building-block set"
             into a dense, learnable one, using a retrosynthesis model (syntheseus) in the loop. It
             is the first generative approach to CONSTRAINED synthesizability (starting-material,
             intermediate and divergent-synthesis constraints). Uniquely valuable here because the
             constraint set is caller-supplied: TANGO can be run on the same public ZINCFrag
             catalogue as the other baselines AND, separately, constrained to our own 418
             glue_standard_v1 blocks -- the second arm forecloses the "different catalogue" objection
             to the head-to-head outright, since both sides then build from identical chemistry.}
}

@article{gao2025synformer,
