# SCENT FIXED-REWARD on sEH (surrogate) — 5,000-iteration variant (campaign Logs/030).
#
# scent_seh_fixed.gin already ran 5000 iters, so this is effectively identical — re-run for
# uniform campaign provenance. Reaction cap stays at the clone default of 4 (the +1-reaction idea
# was dropped; Logs/030 Results). Frozen @SehMoleculeProxy, SMALL library, beta=8, routes.
#
# Run (repo root, scent env; candidate emission shells to the rgfn env):
#   conda run -n scent python validation/generators/scent/run_scent_fixed.py \
#       --cfg validation/configs/scent_seh_fixed_5k.gin --root-dir $SCRATCH/rgfn_runs/experiments

include 'configs/scent_base.gin'
include 'configs/envs/settings/small.gin'
include 'configs/proxies/target/seh.gin'

beta = 8
WandbLogger.mode = 'offline'

# ⛔ THE CEILING IS A BACKSTOP, NOT THE BUDGET (raised 2026-09-18, researcher's ruling that arm B
# IS 320,000 distinct molecules). At 5,000 this bound BEFORE the budget did and the run stopped
# early with the budget unspent -- seeds 42/43/44 stopped at 226,169 / 223,814 / 231,751 on a tail rate of ~41/iter. Nothing
# flagged it: the runs exited 0 and every artifact looked complete. Sized from the measured
# tail rate of those very runs plus headroom, so the BUDGET STOP is what ends the run and this
# number never binds again. If it ever does bind, the cell is short and must be extended, not
# reported.
Trainer.n_iterations = 9000
Trainer.valid_every_n_iterations = 250   # periodic checkpoint cadence for 3-day auto-requeue (Logs/030)
trainer/gin.singleton.constructor = @Trainer
trainer = @trainer/gin.singleton()

ScentFixedRewardRun.trainer = %trainer
ScentFixedRewardRun.reward_generator = %train_proxy
ScentFixedRewardRun.n_samples = 1000
ScentFixedRewardRun.sample_oversample = 4.0
ScentFixedRewardRun.top_k = 100
ScentFixedRewardRun.system = 'seh'
ScentFixedRewardRun.generator_name = 'scent'
ScentFixedRewardRun.reward_name = 'seh_proxy'
