# SCENT FIXED-REWARD on DRD2 (surrogate) — 5,000-iteration variant (campaign Logs/030).
#
# scent_drd2_fixed.gin already ran 5000 iters, so this is effectively identical — re-run for
# uniform campaign provenance. Reaction cap stays at the clone default of 4 (the +1-reaction idea
# was dropped; Logs/030 Results). Frozen @TDCProxy(DRD2), SMALL library, beta=48, routes.
#
# Run (repo root, scent env; ingest shells to rgfn env):
#   conda run -n scent python validation/generators/scent/run_scent_fixed.py \
#       --cfg validation/configs/scent_drd2_fixed_5k.gin --root-dir $SCRATCH/rgfn_runs/experiments

include 'configs/scent_base.gin'
include 'configs/envs/settings/small.gin'
include 'configs/proxies/target/drd2.gin'

beta = 48
WandbLogger.mode = 'offline'

Trainer.n_iterations = 5000
Trainer.valid_every_n_iterations = 250   # periodic checkpoint cadence for 3-day auto-requeue (Logs/030)
trainer/gin.singleton.constructor = @Trainer
trainer = @trainer/gin.singleton()

ScentFixedRewardRun.trainer = %trainer
ScentFixedRewardRun.reward_generator = %train_proxy
ScentFixedRewardRun.n_samples = 1000
ScentFixedRewardRun.sample_oversample = 4.0
ScentFixedRewardRun.top_k = 100
ScentFixedRewardRun.system = 'drd2'
ScentFixedRewardRun.generator_name = 'scent'
ScentFixedRewardRun.reward_name = 'drd2'
ScentFixedRewardRun.score_units = 'drd2_tdc_activity (higher is better; 0-1)'
