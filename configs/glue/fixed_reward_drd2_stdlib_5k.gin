# 5,000-iteration variant of fixed_reward_drd2_stdlib.gin (campaign Logs/030).
#
# The DRD2 surrogate cell already trained for ~5000 iters (base = rgfn_base.gin's 5002); this
# pins it to exactly 5000 for a uniform matrix budget. Reaction cap stays at the original 4 (the
# +1-reaction idea was dropped for this campaign; Logs/030 Results). Everything else (frozen DRD2
# TDC activity oracle, beta=48, SMALL library, lean metrics) inherited.
#
# Run:  python scripts/fixed_reward.py --cfg configs/glue/fixed_reward_drd2_stdlib_5k.gin --seed 42
include 'configs/glue/fixed_reward_drd2_stdlib.gin'

Trainer.n_iterations = 5000
